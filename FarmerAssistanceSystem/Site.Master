<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="FarmerAssistanceSystem.Site" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <title>Farmer Assistance System</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Navigation -->
        <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" href="<%= ResolveUrl("~/Home.aspx") %>">
                    <i class="bi bi-tree-fill text-primary me-2"></i>
                    Farmer Assistance System
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" href="<%= ResolveUrl("~/Home.aspx") %>">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="<%= ResolveUrl("~/About.aspx") %>">About</a></li>
                        <li class="nav-item"><a class="nav-link" href="<%= ResolveUrl("~/Subsidies.aspx") %>">Subsidies</a></li>
                        <li class="nav-item"><a class="nav-link" href="<%= ResolveUrl("~/Products.aspx") %>">Products</a></li>
                        <li class="nav-item"><a class="nav-link" href="<%= ResolveUrl("~/MarketPrices.aspx") %>">Market Prices</a></li>
                        <li class="nav-item"><a class="nav-link" href="<%= ResolveUrl("~/Contact.aspx") %>">Contact</a></li>
                    </ul>
                    <div class="d-flex gap-2">
                        <a href="<%= ResolveUrl("~/Farmer/FarmerLogin.aspx") %>" class="btn btn-outline-primary"><i class="bi bi-box-arrow-in-right"></i> Farmer Login</a>
                        <a href="<%= ResolveUrl("~/Farmer/FarmerRegister.aspx") %>" class="btn btn-primary"><i class="bi bi-person-plus"></i> Register</a>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <div style="min-height: 80vh;">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>

        <!-- Footer -->
        <footer class="bg-dark text-light py-5 mt-5">
            <div class="container">
                <div class="row g-4">
                    <div class="col-md-4">
                        <h5 class="text-white mb-3"><i class="bi bi-tree-fill text-primary"></i> FAS</h5>
                        <p class="text-muted">Empowering farmers through digital access to subsidies, market prices, and agricultural products.</p>
                        <p class="small text-muted"><strong>Note:</strong> This is a demonstration project.</p>
                    </div>
                    <div class="col-md-4">
                        <h5 class="text-white mb-3">Quick Links</h5>
                        <ul class="list-unstyled">
                            <li><a href="<%= ResolveUrl("~/Subsidies.aspx") %>" class="text-muted text-decoration-none">Available Subsidies</a></li>
                            <li><a href="<%= ResolveUrl("~/MarketPrices.aspx") %>" class="text-muted text-decoration-none">Today's Market Prices</a></li>
                            <li><a href="<%= ResolveUrl("~/Products.aspx") %>" class="text-muted text-decoration-none">Agricultural Products</a></li>
                            <li><a href="<%= ResolveUrl("~/Admin/AdminLogin.aspx") %>" class="text-muted text-decoration-none">Admin Portal</a></li>
                        </ul>
                    </div>
                    <div class="col-md-4">
                        <h5 class="text-white mb-3">Contact Information</h5>
                        <ul class="list-unstyled text-muted">
                            <li><i class="bi bi-geo-alt me-2"></i> Krishi Bhavan, Gujarat, India</li>
                            <li><i class="bi bi-envelope me-2"></i> support@farmerassistance.demo</li>
                            <li><i class="bi bi-telephone me-2"></i> 1800-123-4567</li>
                        </ul>
                    </div>
                </div>
                <hr class="mt-4 mb-4 border-secondary" />
                <div class="text-center text-muted">
                    <p class="mb-0">&copy; <%= DateTime.Now.Year %> Farmer Assistance & Subsidy Management System. All rights reserved.</p>
                </div>
            </div>
        </footer>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="<%= ResolveUrl("~/Scripts/site.js") %>"></script>
</body>
</html>
